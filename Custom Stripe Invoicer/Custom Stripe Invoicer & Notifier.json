ght:1.6;\">\n              Hi {{ $json['Customer Name'] }},\n              <br><br>\n              We've confirmed your payment. Here's a summary of your order.\n            </td>\n          </tr>\n\n          <!-- Order details table -->\n          <tr>\n            <td style=\"padding:24px 40px 0 40px;\">\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-top:1px solid #e5e7eb;\">\n                <tr>\n                  <td colspan=\"2\" style=\"padding:16px 0 8px 0; color:#6b7280; font-size:12px; text-transform:uppercase; letter-spacing:0.5px;\">\n                    Order details\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:6px 0; color:#374151; font-size:14px;\">Item</td>\n                  <td align=\"right\" style=\"padding:6px 0; color:#111827; font-size:14px; font-weight:500;\">{{ $json['Item'] }}</td>\n                </tr>\n                <tr>\n                  <td style=\"padding:6px 0; color:#374151; font-size:14px;\">Quantity</td>\n                  <td align=\"right\" style=\"padding:6px 0; color:#111827; font-size:14px; font-weight:500;\">{{ $json['Quantity'] }}</td>\n                </tr>\n                <tr>\n                  <td style=\"padding:6px 0; color:#374151; font-size:14px;\">Order ID</td>\n                  <td align=\"right\" style=\"padding:6px 0; color:#6b7280; font-size:13px; font-family: monospace;\">{{ $json['Session ID'] }}</td>\n                </tr>\n                <tr>\n                  <td style=\"padding:6px 0; color:#374151; font-size:14px;\">Date</td>\n                  <td align=\"right\" style=\"padding:6px 0; color:#111827; font-size:14px;\">{{ $json['Date'] }}</td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Total -->\n          <tr>\n            <td style=\"padding:20px 40px 0 40px;\">\n              <table role=\"presentation\" width=\